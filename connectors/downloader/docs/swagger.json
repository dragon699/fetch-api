        "response.Torrent": {
            "type": "object",
            "properties": {
                "category": {
                    "type": "string"
                },
                "date_added": {
                    "type": "string"
                },
                "date_completed": {
                    "type": "string"
                },
                "date_last_activity": {
                    "type": "string"
                },
                "eta_minutes": {
                    "type": "integer"
                },
                "files_availability_percentage": {
                    "type": "number"
                },
                "files_count": {
                    "type": "integer"
                },
                "files_path": {
                    "type": "string"
                },
                "hash": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "imdb": {
                    "type": "string"
                },
                "leechers": {
                    "type": "integer"
                },
                "magnet_uri": {
                    "type": "string"
                },
                "meta": {
                    "$ref": "#/definitions/response.TorrentMeta"
                },
                "name": {
                    "type": "string"
                },
                "progress_percentage": {
                    "type": "number"
                },
                "save_path": {
