                },
                "size_downloaded_mb": {
                    "type": "integer"
                },
                "size_left_mb": {
                    "type": "integer"
                },
                "size_mb": {
                    "type": "integer"
                },
                "size_total_gb": {
                    "type": "number"
                },
                "size_total_mb": {
                    "type": "integer"
                },
                "size_uploaded_mb": {
                    "type": "integer"
                },
                "speed_download_mbps": {
                    "type": "number"
                },
                "speed_upload_mbps": {
                    "type": "number"
                },
                "status": {
                    "type": "string"
                },
                "tags": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
